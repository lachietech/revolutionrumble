# Existing MongoDB database (never commit credentials).
MONGO_URI=mongodb://127.0.0.1:27017/revolution-rumble
PORT=5000
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
NODE_ENV=development
TRUST_PROXY_HOPS=0
MONGO_MAX_POOL_SIZE=10

# Comma-separated email addresses allowed to use the admin portal.
ADMIN_EMAILS=admin@example.com
# OTP delivery through the existing Resend integration.
RESEND_API_KEY=

# Confirmation email configuration: see backend/utils/emailService.js.
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
FROM_EMAIL=noreply@revolutionbowlingsupplies.com
